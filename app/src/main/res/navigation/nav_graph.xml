<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/EdgeToEdgeFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.tp.recyclertree.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/EdgeToEdgeFragment" />
    </fragment>
    <fragment
        android:id="@+id/EdgeToEdgeFragment"
        android:name="com.tp.recyclertree.edgeToEdgeSample.EdgeToEdgeContentFragment"
        android:label="@string/edger_to_edge_fragment_label"
        tools:layout="@layout/fragment_edge_to_edge_content">
    </fragment>

    <fragment
        android:id="@+id/ViewPagerFragment"
        android:name="com.tp.recyclertree.viewpagersample.ViewPagerSampleFragment"
        android:label="@string/view_pager_fragment"
        tools:layout="@layout/fragment_view_pager_sample">

        <action
            android:id="@+id/action_ViewPagerFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/TimeLineFragment"
        android:name="com.tp.recyclertree.timelineSample.TimelineFragment"
        android:label="@string/timeline_fragment"
        tools:layout="@layout/fragment_timeline">

        <action
            android:id="@+id/action_TimeLineFragment_to_ViewPagerFragment"
            app:destination="@id/ViewPagerFragment" />
    </fragment>
    <fragment
        android:id="@+id/MileStoneFragment"
        android:name="com.tp.recyclertree.milestonesample.MilestoneFragment"
        android:label="@string/milestone_fragment"
        tools:layout="@layout/fragment_timeline">

        <action
            android:id="@+id/action_MileStoneFragment_to_ViewPagerFragment"
            app:destination="@id/ViewPagerFragment" />
    </fragment>
</navigation>