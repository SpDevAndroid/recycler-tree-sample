<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="GlowButton">
        <attr name="buttonColor" format="color" />
        <attr name="glowColor" format="color" />
        <attr name="strokeColor" format="color" />
        <attr name="unpressedGlowSize" format="dimension" />
        <attr name="pressedGlowSize" format="dimension" />
        <attr name="cornerRadiusGlowButton" format="dimension" />
        <attr name="strokeSize" format="dimension" />
    </declare-styleable>

    <style name="text_space_char">
        <item name="fontFamily">@font/raleway_bold</item>
        <item name="android:fontFamily">@font/raleway_bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.21</item>
    </style>
</resources>