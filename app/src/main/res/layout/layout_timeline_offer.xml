<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_5"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="183dp"
        android:layout_height="wrap_content"
        android:background="@drawable/active_icon_cta_bg_1"
        android:backgroundTint="@color/timeline_offer_bg_color">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/margin_1"
            android:paddingVertical="@dimen/margin_4"
            android:text="Find complimentary airport lounges wherever you go"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/margin_1"
            android:paddingVertical="@dimen/margin_2"
            android:text="LOUNGE ACCESS"
            android:textColor="@color/tp_cta_bg_color_2"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="177dp"
            android:layout_margin="@dimen/margin_0"
            app:cardBackgroundColor="@color/transparent"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/img_view_pager_sample_2" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="2dp"
        android:layout_height="89dp"
        android:background="@drawable/active_icon_cta_bg_1"
        android:backgroundTint="@color/timeline_offer_line_color" />

</androidx.appcompat.widget.LinearLayoutCompat>
