<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:paddingEnd="@dimen/margin_3"
    android:layout_height="484dp">

    <include
        android:id="@+id/userStatusView"
        layout="@layout/layout_item_user_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/cl_axis_line"
        layout="@layout/layout_timeline_axis"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/margin_4"
        app:layout_constraintStart_toEndOf="@+id/userStatusView"/>



    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_axis_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/tp_cta_bg_color_2"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/cl_axis_line"
        app:layout_constraintStart_toStartOf="@id/cl_axis_line"
        tools:text="100k" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_current_user_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/tp_cta_bg_color_2"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/userStatusView"
        app:layout_constraintStart_toStartOf="@id/userStatusView"
        tools:text="100k" />

</androidx.constraintlayout.widget.ConstraintLayout>